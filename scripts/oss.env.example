# 阿里云 OSS 配置 (backup 进程读取)。
# 用法: 复制为 oss.env 并填入你自己的值, 然后:
#   set -a; source scripts/oss.env; set +a
#   export LD_LIBRARY_PATH=/usr/local/lib
#   ./backup
#
# 切勿把填好真实密钥的 oss.env 提交到 git (已可在 .gitignore 忽略)。

# OSS 访问域名 (在 OSS 控制台 -> 你的 Bucket -> 概览 -> 访问端口 查看)
export OSS_ENDPOINT="oss-cn-hangzhou.aliyuncs.com"

# 地域 ID (与 endpoint 对应, 如 cn-hangzhou / cn-beijing / cn-shenzhen ...)
export OSS_REGION="cn-hangzhou"

# 你的 Bucket 名称
export OSS_BUCKET="your-bucket-name"

# AccessKey (强烈建议用 RAM 子账号的 AK, 只授予该 Bucket 的读写权限, 不要用主账号 AK)
export OSS_ACCESS_KEY_ID="your-access-key-id"
export OSS_ACCESS_KEY_SECRET="your-access-key-secret"
